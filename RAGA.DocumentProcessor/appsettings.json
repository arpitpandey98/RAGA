{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=RagaDb;Trusted_Connection=True;TrustServerCertificate=True;"
    //"DefaultConnection": "Server=tcp:raga-sql-server-01.database.windows.net,1433;Initial Catalog=RagaDb;Persist Security Info=False;User ID=ragaadmin;Password={};MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;"
  },
  "AzureOpenAI": {
    "EmbeddingDeployment": "text-embedding-3-small",
