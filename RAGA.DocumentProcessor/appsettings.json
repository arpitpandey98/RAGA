    "ChatDeployment": "gpt-5-mini"
  },
  "AzureSearch": {
    "Endpoint": "https://raga-search.search.windows.net",
    "IndexName": "raga-documents"
  },
  "AzureStorage": {
    "ContainerName": "documents"
  }
